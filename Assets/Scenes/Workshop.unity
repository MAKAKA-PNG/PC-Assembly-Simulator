  m_Script: {fileID: 11500000, guid: c9b10b0871066064c9f7819adf239019, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AssemblyTutorial
  steps:
  - Instruction: "\u0429\u0451\u043B\u043A\u043D\u0438\u0442\u0435 \u043F\u043E \u043F\u043B\u0430\u0442\u0435
      \u0441\u043B\u0435\u0432\u0430, \u0437\u0430\u0442\u0435\u043C \u043F\u043E
      \u043C\u043E\u043D\u0442\u0430\u0436\u043D\u043E\u043C\u0443 \u043B\u043E\u0442\u043A\u0443
      \u0432 \u043A\u043E\u0440\u043F\u0443\u0441\u0435 \u0441\u043F\u0440\u0430\u0432\u0430."
    Slot: {fileID: 910300491}
    First: {fileID: 0}
    Second: {fileID: 0}
  - Instruction: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440
      \u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043F\u0440\u043E\u0437\u0440\u0430\u0447\u043D\u044B\u0439
      \u043A\u0432\u0430\u0434\u0440\u0430\u0442 \u0441\u043E\u043A\u0435\u0442\u0430
      \u043D\u0430 \u043F\u043B\u0430\u0442\u0435."
    Slot: {fileID: 1177161404}
    First: {fileID: 0}
    Second: {fileID: 0}
  - Instruction: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u0431\u0430\u0448\u0435\u043D\u043D\u044B\u0439
      \u043A\u0443\u043B\u0435\u0440 \u043D\u0430 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440:
      \u043E\u0441\u043D\u043E\u0432\u0430\u043D\u0438\u0435 \u043E\u0442\u0432\u043E\u0434\u0438\u0442
      \u043E\u0442 \u043D\u0435\u0433\u043E \u0442\u0435\u043F\u043B\u043E."
    Slot: {fileID: 1868121772}
    First: {fileID: 0}
    Second: {fileID: 0}
  - Instruction: "\u0412\u044B\u0431\u0435\u0440\u0438\u0442\u0435 \u043B\u044E\u0431\u0443\u044E
      \u043F\u043B\u0430\u043D\u043A\u0443 \u043F\u0430\u043C\u044F\u0442\u0438 \u0438
      \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u0435\u0451 \u0432
      \u043F\u0435\u0440\u0432\u044B\u0439 \u0434\u043B\u0438\u043D\u043D\u044B\u0439
      \u0441\u043B\u043E\u0442 DIMM."
    Slot: {fileID: 870046098}
    First: {fileID: 0}
    Second: {fileID: 0}
  - Instruction: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u0432\u0442\u043E\u0440\u0443\u044E
      \u043F\u043B\u0430\u043D\u043A\u0443 \u0432 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0439
      \u0441\u043B\u043E\u0442 DIMM \u0440\u044F\u0434\u043E\u043C \u0441 \u043F\u0435\u0440\u0432\u043E\u0439."
    Slot: {fileID: 1424973847}
    First: {fileID: 0}
    Second: {fileID: 0}
  - Instruction: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u0432\u0438\u0434\u0435\u043E\u043A\u0430\u0440\u0442\u0443
      \u0432 \u0434\u043B\u0438\u043D\u043D\u044B\u0439 \u0441\u043B\u043E\u0442
      PCIe \u043D\u0430 \u043F\u043B\u0430\u0442\u0435."
    Slot: {fileID: 362109905}
    First: {fileID: 0}
    Second: {fileID: 0}
  - Instruction: "\u041F\u043E\u043C\u0435\u0441\u0442\u0438\u0442\u0435 \u0431\u043B\u043E\u043A
      \u043F\u0438\u0442\u0430\u043D\u0438\u044F \u0432 \u0448\u0438\u0440\u043E\u043A\u0438\u0439
      \u043E\u0442\u0441\u0435\u043A \u043A\u043E\u0440\u043F\u0443\u0441\u0430 \u0440\u044F\u0434\u043E\u043C
      \u0441 \u043F\u043B\u0430\u0442\u043E\u0439."
    Slot: {fileID: 990085716}
    First: {fileID: 0}
    Second: {fileID: 0}
  - Instruction: "\u0423\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 SATA
      SSD \u0432 \u043F\u043B\u043E\u0441\u043A\u0438\u0439 \u043E\u0442\u0441\u0435\u043A
      \u0434\u043B\u044F \u043D\u0430\u043A\u043E\u043F\u0438\u0442\u0435\u043B\u044F."
    Slot: {fileID: 2111481450}
    First: {fileID: 0}
    Second: {fileID: 0}
  - Instruction: "\u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043F\u043B\u0430\u0442\u044B.
      \u041F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435
      PSU_ATX24 \u0438 MB_ATX24."
    Slot: {fileID: 0}
    First: {fileID: 1958020786}
    Second: {fileID: 1712968717}
  - Instruction: "\u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0440\u0430.
      \u041F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435
      PSU_CPU_EPS8 \u0438 MB_CPU_EPS8."
    Slot: {fileID: 0}
    First: {fileID: 1978836738}
    Second: {fileID: 268684944}
  - Instruction: "\u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u0432\u0438\u0434\u0435\u043E\u043A\u0430\u0440\u0442\u044B.
      \u041F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435
      PSU_PCIE8 \u0438 GPU_PCIE8."
    Slot: {fileID: 0}
    First: {fileID: 311365817}
    Second: {fileID: 174322947}
  - Instruction: "\u0423\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0432\u0435\u043D\u0442\u0438\u043B\u044F\u0442\u043E\u0440\u043E\u043C.
      \u041F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435
      COOLER_CPU_FAN \u0438 MB_CPU_FAN."
    Slot: {fileID: 0}
    First: {fileID: 155113999}
    Second: {fileID: 1881779502}
  - Instruction: "\u041F\u0438\u0442\u0430\u043D\u0438\u0435 \u043D\u0430\u043A\u043E\u043F\u0438\u0442\u0435\u043B\u044F.
      \u041F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435
      PSU_SATA_POWER \u0438 SSD_SATA_POWER."
    Slot: {fileID: 0}
    First: {fileID: 2070768375}
    Second: {fileID: 1612769099}
  - Instruction: "\u041F\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u0434\u0430\u043D\u043D\u044B\u0445
      SATA. \u041F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0432\u044B\u0431\u0435\u0440\u0438\u0442\u0435
      MB_SATA_DATA \u0438 SSD_SATA_DATA."
    Slot: {fileID: 0}
    First: {fileID: 440994940}
    Second: {fileID: 37582547}
  - Instruction: "\u041F\u0435\u0440\u0435\u0434\u043D\u044F\u044F \u043F\u0430\u043D\u0435\u043B\u044C:
      \u0441\u043E\u0435\u0434\u0438\u043D\u0438\u0442\u0435 CASE_PWR_SW \u0438 MB_PWR_SW."
